# Environment Variables — TestCraft
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe for browser — not a secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (safe for browser — heavily scoped)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── IMPORTANT ────────────────────────────────────────────────────────────────
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here or anywhere in the frontend.
# Service role keys bypass all RLS policies and must stay server-only
# (e.g., in Supabase Edge Functions or secure backend APIs only).
# ─────────────────────────────────────────────────────────────────────────────

# Curriculum Factory (server-only; set verified current model prices)
OPENAI_API_KEY=
CURRICULUM_MODEL=
CURRICULUM_INPUT_USD_PER_MILLION=
CURRICULUM_OUTPUT_USD_PER_MILLION=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_DEMO_SEED=false
